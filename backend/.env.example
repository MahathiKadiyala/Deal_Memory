# Supabase PostgreSQL Connection String Example:
# DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dealmemory
APP_NAME=DealMemory API
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
JWT_SECRET_KEY=your-secure-jwt-secret-key-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Hindsight Experiential Memory Configuration
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your-hindsight-api-key
HINDSIGHT_BANK_ID=dealmemory

# Groq LLM Configuration
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
